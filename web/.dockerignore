# ============================================================
#  Docker 构建上下文忽略清单
#  目的：减小发送给 Docker 的构建上下文体积，加快构建、避免缓存失效
#  注意：这里忽略的只是"构建上下文"，不影响镜像里的文件
# ============================================================

# 依赖与构建产物（容器里会重新安装/重新构建）
node_modules
dist
dist-ssr

# 日志
logs
*.log

# IDE / 本地配置
.vscode
.idea
.DS_Store

# Git
.git
.gitignore

# 文档与辅助脚本（镜像里用不到）
README.md
check_imports.js

# 部署相关（镜像构建本身不需要它们）
Dockerfile
.dockerignore
docker-compose.yml
